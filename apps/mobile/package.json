{
  "name": "@diki/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .js,.mjs,.ts,.tsx",
    "lint:fix": "eslint --fix . --ext .js,.mjs,.ts,.tsx",
    "check:theme": "node scripts/checkTheme.mjs",
    "check:screens": "node scripts/checkScreens.mjs",
    "check:react": "node scripts/checkReactResolution.mjs",
    "sync-content": "node scripts/syncContent.mjs",
    "check:snapshot": "node scripts/checkSnapshot.mjs",
    "copy-mathjax": "node scripts/copyMathJax.mjs",
    "postinstall": "node scripts/copyMathJax.mjs",
    "check:mathjax": "node scripts/checkMathJaxAsset.mjs"
  },
  "dependencies": {
    "@diki/core": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.14",
    "expo-asset": "~58.0.16",
    "expo-constants": "~58.0.12",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.23",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "mathjax": "^3.2.2",
    "typescript": "~6.0.3"
  }
}
